# LIVE MODE ONLY — paper mode does not need or read wallet credentials.
# MetaMask private key that signs for your Polymarket proxy (NEVER commit the real key).
# Prefer a process supervisor/secret manager. If copied to .env, restrict that
# file first (POSIX: chmod 600 .env; Windows: see SECURITY.md).
POLY_PRIVATE_KEY=your_private_key_here

# Example for an existing type-2 proxy/Safe account. These values must match
# the actual Polymarket account type. Type 3 is blocked while upstream
# py-clob-client-v2 issue #70 remains unresolved.
POLY_FUNDER=your_polymarket_proxy_address_here
POLY_SIGNATURE_TYPE=2

# Trade settings (A.5 defaults)
BET_SIZE=5
TRADE_LAST_SECONDS=300
TRADE_INTERVAL_SECONDS=12
MAX_BUY_PRICE=0.90
MIN_BUY_PRICE=0.20
# FOK orders do not normally rest. Keep wallet-wide cancel-all disabled so the
# bot cannot cancel unrelated manual orders. Dedicated bot wallets may opt in
# with both settings below.
CANCEL_OPEN_BEFORE_TRADE=0
# ALLOW_GLOBAL_CANCEL_ALL=1
# Optional; default is BET_SIZE × the number of TRADE_INTERVAL_SECONDS slots.
# MAX_ROUND_EXPOSURE=20
MAX_ALLOWED_SPREAD=0.25
BTC_STALE_AFTER=3
ORDERBOOK_MAX_AGE_SECONDS=8
TWAP_STALE_AFTER=10
CLOCK_MAX_DRIFT_SECONDS=2
MIN_SECONDS_TO_EXPIRY=1

# Paper mode: python run_feeds.py --paper --dash
# Used only when paper_account.json does not already exist.
PAPER_START_BALANCE=1000
# Optional persistent paper files (relative paths live beside the bot)
# PAPER_LEDGER_PATH=paper_ledger.json
# PAPER_ACCOUNT_PATH=paper_account.json
# PAPER_AUDIT_PATH=paper_orders.jsonl
# PAPER_LATENCY_MS=150

# Feed mode. Safe default keeps REST as the decision source while scoring WS.
BOOK_SOURCE=ws_shadow
BOOK_AUDIT=on
BTC_FEED=ws
PRICE_STALE_POLICY=none
USER_WS=on
RECONCILE=auto

# Optional token overrides (bot auto-discovers BTC 5m each round)
# UP_TOKEN_ID=
# DOWN_TOKEN_ID=
# NEG_RISK=            # 1/true or 0/false; leave unset to auto-detect
# TICK_SIZE=           # leave unset to auto-detect

# Do not set CLOB_HOST unless you own and trust the endpoint. Authenticated
# requests are locked to https://clob.polymarket.com by default.
# A custom HTTPS origin additionally requires: ALLOW_CUSTOM_CLOB_HOST=1
